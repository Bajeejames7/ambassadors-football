# --- Required ---------------------------------------------------------------
# Postgres connection string (Neon, Render Postgres, or local Docker)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ambassadors
# Whoever signs up with this email is a Super Admin (cannot be removed).
CREATOR_EMAIL=creator@example.org
# Long random string that signs logins. Changing it signs everyone out.
TOKEN_SECRET=change-me-to-a-long-random-string
# The public https address of this app (used for the M-PESA callback URL).
PUBLIC_URL=https://your-app.onrender.com
PORT=3000

# --- M-PESA (Safaricom Daraja) ---------------------------------------------
# mock = no Safaricom calls; payments auto-complete after ~5 s (for demos)
# sandbox = Daraja sandbox; production = live
MPESA_MODE=mock
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox test values: shortcode 174379 and the passkey from the Daraja portal
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Random string; part of the callback URL so only Safaricom (who knows it) can call it
MPESA_CALLBACK_SECRET=change-me-too

# --- Airtable (optional fallback) -------------------------------------------
# Each intramural sets its own Airtable token in Setup. This one is used for
# intramurals that have a base configured but no token of their own.
AIRTABLE_API_KEY=
