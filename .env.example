# Pooled connection for the app (Neon/Supabase pooler or PgBouncer)
DATABASE_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct connection, used only by `prisma migrate`
DIRECT_URL="postgres://USER:PASSWORD@HOST/DB?sslmode=require"
# Max DB connections per server instance (3 suits a 512 MB instance)
DB_POOL_MAX=3
# 32+ random characters; signs session cookies. Changing it signs everyone out.
SESSION_SECRET=
# Whoever holds this email is always a Super Admin
CREATOR_EMAIL=
# 32-byte key (base64) for encrypting per-intramural Airtable tokens (used in Step 2)
AIRTABLE_ENCRYPTION_KEY=
